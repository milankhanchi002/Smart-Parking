# -----------------------------------------------------
# PRODUCTION ENVIRONMENT VARIABLES (Railway)
# Copy these keys into your Railway Variables settings.
# -----------------------------------------------------

# Application Port
PORT=5001

# The URL of your deployed React Frontend (used for CORS)
FRONTEND_URL=https://your-frontend-url.vercel.app

# Database Connection
# Railway provides DATABASE_URL automatically. If provided, the code uses it.
# Otherwise, provide these locally:
# PG_HOST=localhost
# PG_USER=postgres
# PG_DATABASE=quickpark
# PG_PASSWORD=yourpassword
# PG_PORT=5432

# Razorpay Keys
RAZORPAY_KEY_ID=rzp_test_YourKeyId
RAZORPAY_KEY_SECRET=YourKeySecret

# Email configuration (Resend SMTP)
EMAIL_USER=resend
RESEND_API_KEY=re_YourResendApiKey
EMAIL_FROM="onboarding@resend.dev"
