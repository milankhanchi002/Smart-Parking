# -----------------------------------------------------
# BACKEND ENVIRONMENT VARIABLES
# Copy these keys into your local backend/.env or your Railway Variables settings.
# -----------------------------------------------------

# Application Port
PORT=5001

# JSON Web Token Secret
JWT_SECRET=your_super_secret_jwt_key

# PostgreSQL Database Connection URL (e.g. Neon)
DATABASE_URL=postgresql://username:password@host/database?sslmode=require

# Razorpay API Credentials
RAZORPAY_KEY_ID=rzp_test_YourRazorpayKeyId
RAZORPAY_KEY_SECRET=YourRazorpayKeySecret

# Resend API Delivery Credentials
RESEND_API_KEY=re_YourResendApiKey
FROM_EMAIL=QuickPark <onboarding@resend.dev>
